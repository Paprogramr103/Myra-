<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:layout_width="160dp"
    android:layout_height="160dp"
    android:background="@drawable/bg_overlay_orb"
    android:padding="8dp">

    <com.myra.assistant.ui.components.OrbAnimationView
        android:id="@+id/overlayOrbView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <TextView
        android:id="@+id/overlayLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="4dp"
        android:fontFamily="monospace"
        android:letterSpacing="0.2"
        android:text="@string/app_name"
        android:textColor="#EEEEEE"
        android:textSize="11sp"
        android:textStyle="bold" />

    <ImageButton
        android:id="@+id/overlayCloseBtn"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="top|end"
        android:background="@android:color/transparent"
        android:contentDescription="Close floating orb"
        android:padding="4dp"
        android:src="@drawable/ic_close" />

</FrameLayout>
